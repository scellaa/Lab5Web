<h3>Daftar Menu Makanan dan Minuman</h3>
<label><input type="checkbox" class="menu" value="15000"> Ayam Goreng — Rp15.000</label><br>
<label><input type="checkbox" class="menu" value="15000"> Bebek Goreng - Rp15.0000</label><br>
<label><input type="checkbox" class="menu" value="2000"> Tempe — Rp2.000</label><br>
<label><input type="checkbox" class="menu" value="5000"> Telur Dadar — Rp5.000</label><br>
<label><input type="checkbox" class="menu" value="3000"> Nasi Putih — Rp3.000</label><br>
<label><input type="checkbox" class="menu" value="7000"> Sayur Asem — Rp7.000</label><br>
<label><input type="checkbox" class="menu" value="5000"> Es Teh Manis — Rp5.000</label><br>
<p>Total: Rp<span id="total">0</span></p>

<script>
  const daftarMenu = document.querySelectorAll(".menu");
  daftarMenu.forEach((item) => {
    item.addEventListener("change", hitungTotal);
  });

  function hitungTotal() {
    let total = 0;
    daftarMenu.forEach((item) => {
      if (item.checked) total += Number(item.value);
    });
    document.getElementById("total").textContent = total.toLocaleString("id-ID");
  }
</script>


