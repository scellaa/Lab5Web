<button type="button" id="tombolToggle" aria-expanded="true">Sembunyikan</button>
<p id="konten">Halo nama saya Mayscela.</p>

<script>
  const tombol = document.getElementById("tombolToggle");
  const konten = document.getElementById("konten");

  tombol.addEventListener("click", function () {
    konten.hidden = !konten.hidden;

    tombol.textContent = konten.hidden ? "Tampilkan" : "Sembunyikan";
    tombol.setAttribute("aria-expanded", String(!konten.hidden));
  });
</script>
